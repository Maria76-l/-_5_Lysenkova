# Блок объявления функции
{ pkgs }: {
  # Nix-выражение определяется как функция, принимающая аргумент pkgs.
  # pkgs — это атрибутный набор (attribute set) всех доступных пакетов
  # из выбранного Nix-канала (stable-22_11, заданного в .replit).
  # Эта функция вызывается автоматически средой Nix при сборке окружения.
# Блок объявления системных зависимостей
  deps = [
    # deps — список системных пакетов, которые будут установлены в изолированное Nix-окружение проекта.
    # Nix обеспечивает воспроизводимость

    pkgs.replitPackages.prybar-python310
    # prybar-python310 — специализированный инструмент Replit.
    # Реализует интерактивный Python REPL (интерактивную консоль),
    # который появляется в панели "Shell" при выборе Python.
    # Версия python310 соответствует Python 3.10, указанному в pyproject.toml.

    pkgs.replitPackages.stderred
  ];
  # stderred (stderr red) — утилита для перекраски стандартного потока ошибок.
  # Перехватывает вывод stderr и выводит его красным цветом в терминале, что позволяет мгновенно визуально отличить ошибки от обычного вывода.

}
# Результат функции — атрибутный набор { deps = [...] }, который Nix интерпретирует как описание окружения сборки.
# Nix устанавливает все перечисленные пакеты в изолированное окружение, не затрагивая системные пакеты 
